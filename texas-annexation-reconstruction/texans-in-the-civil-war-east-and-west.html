(function () {
  document.querySelectorAll('.ow-road').forEach(function (w) {
    var stops = JSON.parse(w.querySelector('script[type="application/json"]').textContent);
    var slider = w.querySelector('input[type=range]');
    var dots = w.querySelectorAll('.stop');
    var done = w.querySelector('.road-done');
    function render() {
      var i = parseInt(slider.value, 10), s = stops[i];
      dots.forEach(function (d, n) { d.classList.toggle('seen', n < i); d.classList.toggle('here', n === i); });
      done.style.width = (i / (stops.length - 1) * 100) + '%';
      w.querySelector('.road-date').textContent = s.date;
      w.querySelector('.road-title').textContent = s.title;
      w.querySelector('.road-body').textContent = s.body;
      w.querySelector('.road-note').textContent = s.note;
    }
    slider.addEventListener('input', render);
    w.querySelector('.widget-reset').addEventListener('click', function () { slider.value = 0; render(); });
    render();
  });

  document.addEventListener('click', function (e) {
    var it = e.target.closest('.ow-seq .seq-item');
