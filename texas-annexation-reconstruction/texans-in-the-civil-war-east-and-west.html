      } else {
        it.classList.add('bad');
        msg.textContent = w.dataset.hint || 'Not yet. Which of these came earlier?';
        setTimeout(function () { it.classList.remove('bad'); }, 700);
      }
      return;
    }
    var rs = e.target.closest('.ow-seq .widget-reset');
    if (rs) {
      var q = rs.closest('.ow-seq');
      q.dataset.next = 0;
      q.querySelectorAll('.seq-item').forEach(function (b) { b.classList.remove('placed', 'bad'); });
      q.querySelector('.seq-line').innerHTML = '';
      q.querySelector('.seq-msg').textContent = '';
      var f = q.querySelector('.widget-feedback'); f.textContent = ''; f.classList.remove('show');
    }
  });
})();
