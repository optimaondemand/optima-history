<script>
(function () {
  document.addEventListener('click', function (e) {
    var reset = e.target.closest('.widget-reset');
    if (reset) {
      var w = reset.closest('.optima-widget');
      w.querySelectorAll('.widget-options button').forEach(function (b) { b.classList.remove('selected', 'correct', 'incorrect'); });
      w.querySelectorAll('.widget-feedback').forEach(function (f) { f.classList.remove('show'); f.textContent = ''; });
      w.querySelectorAll('.row-feedback').forEach(function (f) { f.remove(); });
      w.querySelectorAll('.ow-flip.flipped').forEach(function (c) { c.classList.remove('flipped'); });
      return;
    }
    var rBtn = e.target.closest('.ow-reflect .widget-options button');
    if (rBtn) {
      var rw = rBtn.closest('.optima-widget');
      rw.querySelectorAll('.widget-options button').forEach(function (b) { b.classList.remove('selected'); });
      rBtn.classList.add('selected');
      var fb = rw.querySelector('.widget-feedback');
      fb.textContent = rBtn.dataset.response || '';
      fb.classList.add('show');
      return;
    }
    var sBtn = e.target.closest('.ow-select .widget-row .widget-options button, .ow-scale .widget-row .widget-options button');
    if (sBtn) {
      var row = sBtn.closest('.widget-row');
      var correct = row.dataset.correct;
      row.querySelectorAll('.widget-options button').forEach(function (b) { b.classList.remove('selected', 'correct', 'incorrect'); });
      var right = sBtn.dataset.choice === correct;
      sBtn.classList.add(right ? 'correct' : 'incorrect');
      var text = right ? (sBtn.dataset.fb || row.dataset.fb || 'Right.') : (sBtn.dataset.fb || row.dataset.hint || 'Not quite. Try again.');
      var rf = row.querySelector('.row-feedback') || row.appendChild(document.createElement('div'));
      rf.className = 'row-feedback ' + (right ? 'correct' : 'incorrect');
      rf.textContent = text;
      return;
    }
    var flip = e.target.closest('.ow-flip');
    if (flip) { flip.classList.toggle('flipped'); return; }
  });
})();

(function () {
  document.querySelectorAll('.ow-road').forEach(function (w) {
    var stops = JSON.parse(w.querySelector('script[type="application/json"]').textContent);
    var slider = w.querySelector('input[type=range]');
    var dots = w.querySelectorAll('.stop');
    var done = w.querySelector('.road-done');
    function render() {
      var i = parseInt(slider.value, 10), s = stops[i];
      dots.forEach(function (d, n) { d.classList.toggle('seen', n < i); d.classList.toggle('here', n === i); });
      done.style.width = (i / (stops.length - 1) * 100) + '%';
      w.querySelector('.road-date').textContent = s.date;
      w.querySelector('.road-title').textContent = s.title;
      w.querySelector('.road-body').textContent = s.body;
      w.querySelector('.road-note').textContent = s.note;
    }
    slider.addEventListener('input', render);
    w.querySelector('.widget-reset').addEventListener('click', function () { slider.value = 0; render(); });
    render();
  });

  document.addEventListener('click', function (e) {
    var it = e.target.closest('.ow-seq .seq-item');
    if (it && !it.classList.contains('placed')) {
      var w = it.closest('.ow-seq'), next = parseInt(w.dataset.next, 10), n = parseInt(it.dataset.n, 10);
      var msg = w.querySelector('.seq-msg');
      if (n === next) {
        it.classList.add('placed');
        var step = document.createElement('div');
        step.className = 'seq-step';
        step.innerHTML = '<span class="seq-date"></span><span class="seq-text"></span>';
        step.querySelector('.seq-date').textContent = (next + 1) + '. ' + it.dataset.date;
        step.querySelector('.seq-text').textContent = it.dataset.text + '. ' + (it.dataset.fb || '');
        w.querySelector('.seq-line').appendChild(step);
        w.dataset.next = next + 1;
        msg.textContent = '';
        if (next + 1 === w.querySelectorAll('.seq-item').length) {
          var done = w.querySelector('.widget-feedback');
          done.textContent = w.dataset.done || 'All in order.';
          done.classList.add('show');
        }
      } else {
        it.classList.add('bad');
        msg.textContent = w.dataset.hint || 'Not yet. Which of these came earlier?';
        setTimeout(function () { it.classList.remove('bad'); }, 700);
      }
      return;
    }
    var rs = e.target.closest('.ow-seq .widget-reset');
    if (rs) {
      var q = rs.closest('.ow-seq');
      q.dataset.next = 0;
      q.querySelectorAll('.seq-item').forEach(function (b) { b.classList.remove('placed', 'bad'); });
      q.querySelector('.seq-line').innerHTML = '';
      q.querySelector('.seq-msg').textContent = '';
      var f = q.querySelector('.widget-feedback'); f.textContent = ''; f.classList.remove('show');
    }
  });
})();
</script>
